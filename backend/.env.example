# Configure these as server environment variables/secrets. Never put them in the APK.
REPOSQUAD_ACCESS_TOKEN=
GEMINI_API_KEY=
GITHUB_TOKEN=
# Needs repo access; repository creation permission for new:repo-name; workflow scope to write Actions YAML.
GEMINI_MODEL=gemini-3.8-flash
# Paste the full Google AI Studio key as-is (including its AQ... prefix); no Bearer prefix.
# Optional persistent SQLite location (use a persistent disk on your host)
REPOSQUAD_DB=./reposquad.db
