# Configure these as server environment variables/secrets. Never put them in the APK.
REPOSQUAD_ACCESS_TOKEN=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
# Model ID; openrouter/free routes to available free models (subject to limits).
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/davineresmedeiros-dotcom/RepoSquad
# Optional persistent SQLite location (use a persistent disk on your host)
REPOSQUAD_DB=./reposquad.db
